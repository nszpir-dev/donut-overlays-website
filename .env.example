# Copy this file to .env for local testing.
# On Render, you set these as "Environment Variables" in the dashboard instead
# of uploading a .env file — see README.md.

PORT=8080

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/donut-overlays?retryWrites=true&w=majority

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-this-to-something-long-and-random

# Stripe (Developers > API keys). Use the sk_test_... key until you're ready
# to take real money, then switch to sk_live_....
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe (Developers > Webhooks > your endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe (Product catalog > each price's "..." menu > copy Price ID)
STRIPE_PRICE_SINGLE=price_xxx
STRIPE_PRICE_ALL=price_xxx

# The address people actually visit. Used to build the URLs Stripe sends
# people back to after checkout. Update this once the domain is live.
PUBLIC_URL=https://donutoverlays.com

# Your Discord invite link (discord.gg/xxxxx). Shown when the header
# Discord icon is clicked — change this any time without touching code.
DISCORD_INVITE=https://discord.gg/UPyz79jcth

# Optional: a Discord webhook URL (Server Settings > Integrations >
# Webhooks > New Webhook > Copy Webhook URL). If set, the server posts a
# message there every time someone starts a free trial.
DISCORD_NOTIFY_WEBHOOK_URL=

# Login for the /admin pages. Username defaults to "admin".
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-too

# ---------------------------------------------------------------------
# Email (Resend). Optional — the site works without it, but password
# resets and the "your trial ends in 3 days" reminder are only logged,
# not delivered, until this is set.
#
#   1. Sign up at resend.com (free tier covers a small site)
#   2. API Keys > Create API Key > paste it below
#   3. Leave MAIL_FROM alone to start with. Once donutoverlays.com is
#      yours, add it under Domains, then set
#      MAIL_FROM="Donut Overlays <hello@donutoverlays.com>"
# ---------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=

# ---- Discord roles (all optional) ----
# With none of these set, the site works exactly as before and the
# "Link Discord" button simply does not appear.
#
# Make an application at https://discord.com/developers/applications
#   General Information  -> copy the Application ID       -> DISCORD_CLIENT_ID
#   OAuth2               -> Reset Secret, copy it         -> DISCORD_CLIENT_SECRET
#   OAuth2 > Redirects   -> add https://donutoverlays.com/auth/discord/callback
#   Bot                  -> Reset Token, copy it          -> DISCORD_BOT_TOKEN
#   Installation         -> invite the bot to your server with the
#                           "Manage Roles" permission
# In Discord itself, turn on Developer Mode (Settings > Advanced), then
# right-click your server -> Copy Server ID, and right-click each role
# -> Copy Role ID.
#
# IMPORTANT: in Server Settings > Roles, drag the BOT's own role ABOVE
# any role below. Discord will not let a bot hand out a role that sits
# higher than its own, and the error for that is a bare 403.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ONE ROLE FOR EVERY CUSTOMER - the usual setup, and the one to use
# unless you have a reason not to. Anyone who has paid for anything gets
# it: a live monthly, a free trial, or an overlay bought outright. They
# lose it when they have nothing left. Set this and leave the two below
# empty.
DISCORD_ROLE_CUSTOMER=

# The finer split, only if you want to tell the two apart in your server.
# Leave both empty unless you do.
#   SUB   - whose monthly is currently live (trials included)
#   OWNER - who bought an overlay outright; kept after cancelling,
#           because they keep the overlay
# Putting the same role id in both is safe - it comes out the same as
# using DISCORD_ROLE_CUSTOMER.
DISCORD_ROLE_SUB=
DISCORD_ROLE_OWNER=
